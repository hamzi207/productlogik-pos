# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Project Ref: sgdbhdmsvfmqxlpkrgez, region eu-central-1 Frankfurt)
# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://sgdbhdmsvfmqxlpkrgez.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Postgres connection string (Dashboard → Connect → Session pooler). Used only by
# `npm run db:push` / `npm run db:types`; never exposed to the browser.
SUPABASE_DB_URL=postgresql://postgres.sgdbhdmsvfmqxlpkrgez:YOUR-DB-PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily subscription run (/api/cron/subscriptions): sent as "Authorization: Bearer <secret>".
CRON_SECRET=
